#!/bin/bash

plugin -i slang

# first setup the include paths
verilog_defaults -add -Icode/

# NOTE: code/main_memory.sv (the behavioural instruction/data array) is deliberately
# NOT read here. It is replaced by synthesis/main_memory_bb.sv, a port-identical
# blackbox. Synthesising the array makes tens of thousands of flip-flops whose read
# path dominates the critical path, so every fmax/timing number produced that way
# describes the memory, not the pipeline. Keep the stub's ports in sync with
# code/main_memory.sv; a missing port becomes a hierarchy error, which is the
# failure you want.
read_slang -Icode \
    code/branch_control.sv \
    code/decode.sv \
    code/alu.sv \
    code/fetch.sv \
    code/igen.sv \
    synthesis/main_memory_bb.sv \
    code/memory.sv \
    code/memory_controller.sv \
    code/control.sv \
    code/register_file.sv \
    code/stall_flush_logic.sv \
    code/writeback.sv \
    code/dx_reg.sv \
    code/fd_reg.sv \
    code/mwb_reg.sv \
    code/xm_reg.sv \
    code/rv_core.sv 

    echo on
    hierarchy -check -top rv_core
    select -module rv_core
    select t:*
    select -clear
    show -format dot -prefix rv_core_show rv_core
    proc; opt
    memory; opt
    fsm; opt
    techmap; opt 
    flatten; opt
    dfflibmap -liberty synthesis/sky130nm.lib
    abc -liberty synthesis/sky130nm.lib -D 10000 -script "+strash;dch;map -B 0.9;topo;stime -c;buffer -c;upsize -c;dnsize -c;stime -p"
    setundef -zero
    splitnets
    opt_clean -purge
    write_verilog -noattr synth.v
    write_json synth.json
    stat -liberty synthesis/sky130nm.lib
    exec -expect-return 0 -- sta -exit synthesis/timing.tcl
